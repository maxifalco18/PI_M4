# =============================================================
# VARIABLES DE ENTORNO — .env 
# NUNCA COMMITEAR .env CON VALORES REALES
# =============================================================

# --- AWS (sin credenciales en texto plano — usar IAM Roles) ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=010659610718

# Nombre del bucket S3 (debe ser globalmente único)
S3_BUCKET_NAME=pi-m4-datalake-maxi

# ARN del IAM Role para Lake Formation
LAKEFORMATION_ADMIN_ROLE_ARN=arn:aws:iam::010659610718:user/maxi

# --- PostgreSQL E-commerce (Supabase/Neon — solo lectura) ---
POSTGRES_HOST=CHANGEME_your_supabase_host.pooler.supabase.com
POSTGRES_PORT=6543
POSTGRES_DB=postgres
POSTGRES_USER=CHANGEME_your_readonly_user
POSTGRES_PASSWORD=CHANGEME_your_password

# --- Airbyte Cloud ---
AIRBYTE_API_KEY=CHANGEME
AIRBYTE_WORKSPACE_ID=CHANGEME

# --- OpenWeatherMap API ---
OPENWEATHER_API_KEY=CHANGEME
OPENWEATHER_BASE_URL=https://history.openweathermap.org/data/2.5/history/city

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=./orchestration
AIRFLOW__CORE__FERNET_KEY=CHANGEME_generate_with_fernet
AIRFLOW__WEBSERVER__SECRET_KEY=CHANGEME

# Slack Webhook para alertas (opcional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGEME

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_WEATHER=weather_events
